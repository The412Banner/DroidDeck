<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Session logs go to Downloads so a failed run can be handed over as one folder. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The session keeps running while the app is not on screen: a foreground service holds the
         process at perceptible priority, and a high-performance WiFi lock keeps a backgrounded
         download from being throttled to nothing by the radio's power-save. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Ends background processes of another app that holds the Steam login. GameHub starts
         itself with the phone via boot receivers and signs this client out seconds after every
         login; a normal permission, and it cannot touch anything in the foreground. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- The microphone for the Linux session, only when the user turns it on: the DirectAudio
         relay helper opens the input stream under this uid, and PulseAudio exposes it to the
         Steam client as DirectAudioMic. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:appCategory="game"
        android:isGame="true">

        <!-- A game, to the OS: Android 12+ routes the category through GameManager and the OEM
             performance frameworks (Game Booster, Game Turbo, Game Space) key off it. Without it
             a regular flagship runs the session under its "app" power profile — a conservative
             governor and GPU DVFS — which is why the same chipset feels slower here than in a
             gaming phone whose mode is on for everything. The config says what the OS may do. -->
        <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            A session keeps a Surface, a compositor thread and a proot tree alive; a configuration
            change must not tear that down and rebuild it, so the activity handles them itself.
            Landscape only: gamescope is told one output size when it starts.

            Resizable, deliberately: a foldable opening or closing changes the window, and the
            compositor re-fits the picture with bars. Declared non-resizable, the system keeps a
            fixed-shape window instead and STRETCHES it onto the other panel — the app never sees a
            size change, so nothing it does can help.
        -->
        <activity
            android:name=".files.FileManagerActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".files.FilePickerActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".SessionActivity"
            android:exported="false"
            android:theme="@style/SessionTheme"
            android:preferMinimalPostProcessing="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />

        <!--
            Owns the session — gamescope, the Steam client, audio — so it survives the activity
            going away. Without it Android demotes the process as soon as the last visible
            activity goes, and the low-memory killer reaps the guest: leaving Big Picture to
            answer a message would come back to a dead Steam and a half-finished download.
        -->
        <service
            android:name=".session.SessionService"
            android:exported="false"
            android:stopWithTask="false" />
    </application>
</manifest>
