#!/bin/bash
# `steam` on the desktop. Launch the classic client inside LXQt; explicit Big Picture menu entries
# still use bannerlator-steam-launch to hand off to a Gamescope session.
set -u
if [ "${BL_DESKTOP:-}" = 1 ]; then
  url=
  ui=desktop
  args=()
  for arg in "$@"; do
    case $arg in
      desktop) ui=desktop ;;
      bigpicture|--bigpicture|-bigpicture|--gamepadui|-gamepadui) ui=bigpicture ;;
      steam://*) url=$arg; args+=("$arg") ;;
      *[!0-9]*) args+=("$arg") ;;
      *) url=$arg; args+=("steam://rungameid/$arg") ;;
    esac
  done
  if [ "$ui" = bigpicture ]; then
    exec /usr/local/bin/bannerlator-steam-launch bigpicture ${url:+"$url"}
  fi
  exec /usr/local/bin/bannerlator-steam-desktop "${args[@]}"
fi
exec "${HOME:-/root}/.local/share/Steam/steamrtarm64/steam" "$@"
